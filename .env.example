# Mode yang didukung: conversation
APP_MODE=conversation
LOG_LEVEL=info
WA_CONNECT_ENABLED=false
# Data QR mentah bersifat sensitif. Aktifkan hanya sementara jika benar-benar perlu.
WA_QR_SHOW_RAW=false

# Monitoring defensif dari baileys-antiban. Tidak mengaktifkan fingerprint acak,
# typo buatan, presence palsu, proxy rotation, atau fitur penyamaran lainnya.
SESSION_HEALTH_ENABLED=true
SESSION_BAD_MAC_THRESHOLD=3
SESSION_BAD_MAC_WINDOW_MS=60000

ADMIN_1_AUTH_DIR=./sessions/admin-1
ADMIN_2_AUTH_DIR=./sessions/admin-2

MAX_CONVERSATION_STEPS=10
MESSAGE_DELAY_MS=65000
RECONNECT_LIMIT=5
RECONNECT_BASE_DELAY_MS=2000
RECONNECT_MAX_DELAY_MS=30000
SESSION_READY_TIMEOUT_MS=300000
MANUAL_TEST_STABILIZATION_MS=10000
DELIVERY_RECEIPT_TIMEOUT_MS=30000
