# Mode yang didukung: conversation
APP_MODE=conversation
LOG_LEVEL=info

# Log ke file selain ke console, mirip storage/logs/laravel.log. Default ON,
# satu file per hari (logs/app-YYYY-MM-DD.log). Kegagalan tulis file tidak
# menghentikan aplikasi -- hanya dicatat sebagai error di console.
LOG_TO_FILE_ENABLED=true
LOG_DIRECTORY=./logs

WA_CONNECT_ENABLED=false
# Data QR mentah bersifat sensitif. Aktifkan hanya sementara jika benar-benar perlu.
WA_QR_SHOW_RAW=false

# Monitoring defensif dari baileys-antiban.
SESSION_HEALTH_ENABLED=true
SESSION_BAD_MAC_THRESHOLD=3
SESSION_BAD_MAC_WINDOW_MS=60000

# Presence QA opsional. Default OFF. Saat aktif hanya memakai composing/paused
# dengan timing deterministik untuk pengujian dua akun sendiri. Tidak memakai
# circadian, distraction pause, offline gap, atau proxy rotation. Typo buatan
# adalah fitur TERPISAH (LEGITIMACY_SIGNALS_ENABLED di bawah), bukan bagian
# dari PRESENCE_ENABLED.
PRESENCE_ENABLED=false
PRESENCE_TYPING_WPM=45
PRESENCE_TYPING_MIN_MS=600
PRESENCE_TYPING_MAX_MS=8000

# Human entropy opsional (baileys-antiban HumanEntropyService). Default OFF.
# Saat aktif, background service mengirim typing/read-receipt/presence acak
# ke kontak yang SUDAH pernah mengirim pesan duluan (tidak pernah ke kontak
# baru/asing). Tujuannya semata QA: sesi yang idle sempurna tanpa aktivitas
# apa pun sendiri sudah menjadi sinyal anomali.
HUMAN_ENTROPY_ENABLED=false
HUMAN_ENTROPY_MIN_INTERVAL_MS=300000
HUMAN_ENTROPY_MAX_INTERVAL_MS=900000

# Device fingerprint randomization opsional (baileys-antiban generateFingerprint
# + applyFingerprint). Default OFF. Saat aktif, setiap admin memakai
# appVersion/osVersion/deviceModel acak tapi stabil (deterministik per nama
# session), bukan nilai default Baileys yang identik di semua instalasi.
# Dikalahkan oleh SESSION_FINGERPRINT_ENABLED jika keduanya aktif (lihat di
# bawah), karena session fingerprint adalah superset dari fitur ini.
DEVICE_FINGERPRINT_ENABLED=false

# Stealth connect opsional (baileys-antiban getStealthSocketConfig +
# rampPresenceAfterConnect). Default OFF. Saat aktif: browser tuple acak dari
# pool realistis (dikalahkan oleh DEVICE_FINGERPRINT_ENABLED/
# SESSION_FINGERPRINT_ENABLED jika salah satunya aktif), dan status
# "available" ditunda dengan jeda acak setelah connect alih-alih langsung
# online seperti bot.
STEALTH_CONNECT_ENABLED=false
STEALTH_PRESENCE_RAMP_MIN_MS=30000
STEALTH_PRESENCE_RAMP_MAX_MS=90000

# Read receipt variance opsional (baileys-antiban readReceiptVariance).
# Default OFF. Saat aktif, membungkus sock.readMessages() dengan jeda acak
# Gaussian (bukan instan) sebelum receipt terkirim. Tidak berpengaruh kalau
# tidak ada kode yang memanggil readMessages().
READ_RECEIPT_VARIANCE_ENABLED=false
READ_RECEIPT_VARIANCE_MEAN_MS=1500
READ_RECEIPT_VARIANCE_STDDEV_MS=800

# Legitimacy signals opsional (baileys-antiban LegitimacySignalInjector).
# Default OFF. Saat aktif, sebagian kecil pesan QA (typoProbability) dikirim
# dengan typo QWERTY yang disengaja lalu dikoreksi beberapa saat kemudian --
# meniru pola manusia yang salah ketik. Hanya bagian typo yang dipakai; read
# gap dan mid-typing pause dari modul ini dimatikan (lihat project.md §7.1).
LEGITIMACY_SIGNALS_ENABLED=false
LEGITIMACY_SIGNALS_TYPO_PROBABILITY=0.025

# Session fingerprint opsional (baileys-antiban generateSessionFingerprint +
# applySessionFingerprint) -- superset dari DEVICE_FINGERPRINT_ENABLED yang
# juga menambah jitter network/typing/retry serta metadata voice-note dan
# battery state, semuanya stabil per nama session. Default OFF. Tidak perlu
# mengaktifkan DEVICE_FINGERPRINT_ENABLED juga -- modul ini membuat device
# fingerprint sendiri secara internal.
SESSION_FINGERPRINT_ENABLED=false

# Minimal 2 admin (wajib, selalu aktif walau tidak ditulis di sini).
ADMIN_1_AUTH_DIR=./sessions/admin-1
ADMIN_2_AUTH_DIR=./sessions/admin-2

# Admin ke-3 dst bersifat OPSIONAL -- isi hanya jika ingin menambah nomor lagi.
# Penomoran berhenti begitu ketemu nomor yang kosong (tidak boleh meloncat,
# misal isi ADMIN_3 tapi lewati ADMIN_4 lalu isi ADMIN_5 -- ADMIN_5 tidak
# akan terbaca). Hapus tanda # di depan baris untuk mengaktifkan.
# ADMIN_3_AUTH_DIR=./sessions/admin-3
# ADMIN_4_AUTH_DIR=./sessions/admin-4

# Ambang jumlah pesan terkirim sebelum sebuah nomor dianggap "admin lama"
# (senior). Admin lama yang wajib memulai chat duluan ke admin baru yang
# belum pernah chat dengannya sebelumnya. Lihat newFeture.md.
SENIORITY_THRESHOLD=20

# Lokasi file riwayat "siapa sudah chat dengan siapa" (dibuat/diperbarui
# otomatis saat runtime, format JSON polos -- bukan database). Jangan
# di-commit ke git (sudah masuk .gitignore).
RELATIONSHIP_STATE_FILE=./data/relationship-state.json

MAX_CONVERSATION_STEPS=24
MESSAGE_DELAY_MS=65000
RECONNECT_LIMIT=5
RECONNECT_BASE_DELAY_MS=2000
RECONNECT_MAX_DELAY_MS=30000
SESSION_READY_TIMEOUT_MS=300000
MANUAL_TEST_STABILIZATION_MS=10000
DELIVERY_RECEIPT_TIMEOUT_MS=30000
