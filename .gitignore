node_modules/

# Konfigurasi lokal dan rahasia
.env
.env.*
!.env.example

# Credential/session WhatsApp
sessions/*
!sessions/.gitkeep

# Log runtime
logs/*
!logs/.gitkeep
*.log

# Database/recovery dinonaktifkan pada implementasi awal
data/*.sqlite
data/*.sqlite-*
data/*.db

# Riwayat warm-up bertahap (seniority-based) -- dibuat otomatis saat runtime,
# isinya bukan kode dan bisa dianggap sensitif (pola percakapan antar admin)
data/relationship-state.json
data/.relationship-state.json.tmp-*

# Artefak lokal
coverage/
.DS_Store
Thumbs.db
